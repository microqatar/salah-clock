<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SalahClock" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorPrimaryDark">@color/bg_default</item>
        <item name="colorAccent">@color/accent_default</item>
        <item name="android:windowBackground">@color/bg_default</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.SalahClock.Admin" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorPrimaryDark">@color/bg_default</item>
        <item name="colorAccent">@color/accent_default</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Auto-sizing text: fills whatever space the layout gives it (phone → TV) -->
    <style name="AutoText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">6sp</item>
        <item name="autoSizeMaxTextSize">400sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="AutoText.Dim">
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="AutoText.Clock">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
