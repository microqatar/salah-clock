<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.55"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvCity"
                style="@style/AutoText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3" />
            <TextView
                android:id="@+id/tvMadhab"
                style="@style/AutoText.Dim"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGregorian"
            style="@style/AutoText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.45" />

        <TextView
            android:id="@+id/tvHijri"
            style="@style/AutoText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.45" />

        <LinearLayout
            android:id="@+id/clockArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:gravity="center"
            android:orientation="horizontal">
            <com.microqatar.salahclock.AnalogClockView
                android:id="@+id/analogClock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="6dp" />
            <LinearLayout
                android:id="@+id/digitalArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.4" />
                <TextView
                    android:id="@+id/tvTime"
                    style="@style/AutoText.Clock"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3" />
                <TextView
                    android:id="@+id/tvSubTime"
                    style="@style/AutoText.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.4" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weatherCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:id="@+id/tvWeatherIcon"
                style="@style/AutoText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:gravity="center" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.7"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvTemp"
                    style="@style/AutoText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.6"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvWeatherDesc"
                    style="@style/AutoText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.8" />
                <TextView
                    android:id="@+id/tvWeatherDetails"
                    style="@style/AutoText.Dim"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.7" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/forecastContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nextCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">
            <TextView
                android:id="@+id/tvNextLabel"
                style="@style/AutoText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4" />
            <TextView
                android:id="@+id/tvCountdown"
                style="@style/AutoText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.4"
            android:layout_marginTop="@dimen/gap"
            android:orientation="vertical"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvFooter"
            style="@style/AutoText.Dim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3"
            android:alpha="0.5"
            android:gravity="center"
            android:text="@string/footer_hint" />

    </LinearLayout>

    <TextView
        android:id="@+id/azanBanner"
        style="@style/AutoText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:maxLines="3"
        android:padding="32dp"
        android:visibility="gone" />
</FrameLayout>
